# Local development only. Copy values into your private local env — never commit a real .env.
#
# WARNING: EasyPanel must NEVER use localhost as the DATABASE_URL host.
# Inside a container, localhost is that container, not Postgres. The production
# host is the EasyPanel internal DNS name `{project}_{service}` (typically
# hanin_database). Copy Internal connection URL from Postgres → Credentials,
# then convert the scheme to postgresql+psycopg://. Placeholder shape only:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@hanin_database:5432/DBNAME?sslmode=disable
#
# Keep MAXMIND_MINFRAUD_ENABLED=false. Do not put MaxMind keys, production
# passwords, or EasyPanel secrets in this file or in git.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hanin:hanin_dev_only@localhost:5432/hanin
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
OPENAPI_ENABLED=true
DEMO_OFFER_MAPPING_ENABLED=false
UPSELL_ENABLED=false
UPSELL_PRODUCT_SLUG=
TRACKING_ENABLED=false
PURCHASE_TRACKING_ENABLED=false
RATE_LIMIT_ENABLED=false
ORDER_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=32768
# Google Apps Script Web App /exec URL from google-sheets-webhook.js deploy.
# Script Properties: HANIN_WEBHOOK_SECRET must match SHEETS_WEBHOOK_SECRET.
# Sheet date is Africa/Casablanca (Morocco) from order created_at, DD/MM/YYYY.
SHEETS_WEBHOOK_ENABLED=false
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
SHEETS_TIMEOUT_SECONDS=8
OUTBOX_POLL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=8
META_CAPI_ENABLED=false
META_CAPI_ENDPOINT=
META_ACCESS_TOKEN=
TIKTOK_CAPI_ENABLED=false
TIKTOK_CAPI_ENDPOINT=
TIKTOK_ACCESS_TOKEN=
SNAP_CAPI_ENABLED=false
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=
MAXMIND_MINFRAUD_ENABLED=false
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_MINFRAUD_SERVICE=score
MAXMIND_MINFRAUD_TIMEOUT_SECONDS=8
MAXMIND_MINFRAUD_HOST=minfraud.maxmind.com
TRUSTED_PROXY_IPS=
# Optional sandbox: when true, orders are tagged sandbox=true in the initial
# status_history entry (no schema change, no persistent order-level flag).
# Keep false in production.
SANDBOX_MODE=false
# Comma-separated list of allowed shipping cities. Empty means city is
# accepted from the client but silently dropped server-side. Do NOT invent
# entries — mirror the operations-approved list only.
ALLOWED_CITIES=
